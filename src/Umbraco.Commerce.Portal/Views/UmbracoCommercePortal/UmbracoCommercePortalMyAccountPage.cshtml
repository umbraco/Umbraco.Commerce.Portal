@using Umbraco.Commerce.Portal.Extensions
@using Umbraco.Commerce.Portal.Models
@using Umbraco.Commerce.Portal.Services
@inject IUmbracoCommerceApi CommerceApi
@inject PortalCustomerService PortalCustomerService
@inherits UmbracoViewPage
@{
	Layout = "UmbracoCommercePortalManagementLayout.cshtml";

	var store = Model.GetStore();

	var accountModel = new AccountModel();
	var changePasswordModel = new ChangePasswordModel();
	var addressModel = new AddressBookAddressModel();
	var addressBook = new AddressBook(Array.Empty<AddressBookEntry>(), Array.Empty<AddressBookEntry>());
	var isEditingAddress = false;

	var context = await PortalCustomerService.GetCurrentAsync(store.Id);
	if (context != null)
	{
		accountModel.FirstName = context.Customer.FirstName ?? string.Empty;
		accountModel.LastName = context.Customer.LastName ?? string.Empty;
		accountModel.Email = context.Customer.Email ?? string.Empty;
		accountModel.Telephone = context.Customer.Telephone;

		addressBook = await PortalCustomerService.GetAddressBookAsync(store.Id, context.Customer.Id);

		// Only the signed-in customer's own addresses can be opened for editing
		if (int.TryParse(Context.Request.Query["editAddress"], out var editAddressId))
		{
			var editAddress = await PortalCustomerService.GetCustomerAddressAsync(context.Customer.Id, editAddressId);
			if (editAddress != null)
			{
				isEditingAddress = true;
				addressModel = new AddressBookAddressModel
				{
					Id = editAddress.Id,
					IsBilling = editAddress.IsBilling,
					AddressLine1 = editAddress.AddressLine1,
					AddressLine2 = editAddress.AddressLine2,
					City = editAddress.City,
					ZipCode = editAddress.ZipCode,
					CountryId = editAddress.CountryId,
					RegionId = editAddress.RegionId,
					IsDefault = editAddress.IsDefault,
				};
			}
		}
	}

	var countries = (await CommerceApi.GetCountriesAsync(store.Id)).ToList();
	var regions = (await CommerceApi.GetRegionsAsync(store.Id)).ToList();

	// Keep the posted choice when the address form is shown again with errors
	string? Attempted(string key, object? fallback)
		=> ViewContext.ViewData.ModelState.TryGetValue(key, out var entry) && entry.AttemptedValue != null
			? entry.AttemptedValue
			: fallback?.ToString();

	var selectedCountryId = Attempted("addressModel.CountryId", addressModel.CountryId);
	var selectedRegionId = Attempted("addressModel.RegionId", addressModel.RegionId);
	var selectedIsBilling = Attempted("addressModel.IsBilling", addressModel.IsBilling) ?? "True";
	var selectedCountryHasRegions = regions.Any(x => x.CountryId.ToString() == selectedCountryId);

	string Localize(UmbracoCommercePortalConstants.Localization.LocalizationEntry entry)
		=> Umbraco.GetDictionaryValueOrDefault(entry.Key, entry.DefaultValue);

	var myAccountUrl = Model.Url();
}

@await Html.PartialAsync(
$"{UmbracoCommercePortalConstants.UmbracoCommercePortalViewPath}/Partials/UmbracoCommercePortalManagementHeader.cshtml",
    new ManagementPageHeader(
		Umbraco.GetDictionaryValueOrDefault(UmbracoCommercePortalConstants.Localization.AccountEntries.MyAccount.Key, UmbracoCommercePortalConstants.Localization.AccountEntries.MyAccount.DefaultValue),
		Umbraco.GetDictionaryValueOrDefault(UmbracoCommercePortalConstants.Localization.AccountEntries.ManageAccountDetails.Key, UmbracoCommercePortalConstants.Localization.AccountEntries.ManageAccountDetails.DefaultValue)))

<div class="main__content" id="mainContent">
	<!-- Personal Information -->
	@using (Html.BeginUmbracoForm("UpdateAccount", "UmbracoCommercePortalAccountSurface", FormMethod.Post, new { @class = "form" }))
	{
		<div class="form__section">
			<h3 class="form__section-title">
				@Umbraco.GetDictionaryValueOrDefault(UmbracoCommercePortalConstants.Localization.AccountEntries.PersonalInformation.Key, UmbracoCommercePortalConstants.Localization.AccountEntries.PersonalInformation.DefaultValue)
			</h3>

			<div class="form__row">
				<div class="form__field">
					<label asp-for="@accountModel.FirstName" class="form__label">
						@Umbraco.GetDictionaryValueOrDefault(UmbracoCommercePortalConstants.Localization.AccountEntries.FirstName.Key, UmbracoCommercePortalConstants.Localization.AccountEntries.FirstName.DefaultValue)
					</label>
					<input type="text" asp-for="@accountModel.FirstName" class="form__input" />
				</div>
				<div class="form__field">
					<label asp-for="@accountModel.LastName" class="form__label">
						@Umbraco.GetDictionaryValueOrDefault(UmbracoCommercePortalConstants.Localization.AccountEntries.LastName.Key, UmbracoCommercePortalConstants.Localization.AccountEntries.LastName.DefaultValue)
					</label>
					<input type="text" asp-for="@accountModel.LastName" class="form__input" />
				</div>
			</div>

			<div class="form__row">
				<div class="form__field form__field--full">
					<label asp-for="@accountModel.Email" class="form__label">
						@Umbraco.GetDictionaryValueOrDefault(UmbracoCommercePortalConstants.Localization.AccountEntries.EmailAddress.Key, UmbracoCommercePortalConstants.Localization.AccountEntries.EmailAddress.DefaultValue)
					</label>
					<input type="email" asp-for="@accountModel.Email" class="form__input" />
				</div>
			</div>

			<div class="form__row">
				<div class="form__field form__field--full">
					<label asp-for="@accountModel.Telephone" class="form__label">
						@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.Telephone)
					</label>
					<input type="tel" asp-for="@accountModel.Telephone" class="form__input" />
				</div>
			</div>
		</div>

		@if (Context.Request.HasFormContentType && Context.Request.Form.ContainsKey("update-account-form"))
		{
			<div class="auth__field">
				<div class="auth__error">
					@Html.ValidationSummary()
				</div>
			</div>
		}

		<div class="form__actions">
			<button type="submit" class="button button--primary ucp-bg-color" name="update-account-form">@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.Save)</button>
		</div>
	}


	<!-- Address Book -->
	<div class="form" id="address-book">
		<div class="form__section">
			<h3 class="form__section-title">
				@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.AddressBook)
			</h3>

			@foreach (var group in new[]
			{
				(Title: UmbracoCommercePortalConstants.Localization.AccountEntries.BillingAddresses, Entries: addressBook.BillingAddresses),
				(Title: UmbracoCommercePortalConstants.Localization.AccountEntries.ShippingAddresses, Entries: addressBook.ShippingAddresses),
			})
			{
				<h4 class="address-book__title">@Localize(group.Title)</h4>

				@if (group.Entries.Count == 0)
				{
					<p class="address-book__empty">@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.NoAddresses)</p>
				}
				else
				{
					<ul class="address-book__list">
						@foreach (var entry in group.Entries)
						{
							var address = entry.Address;
							<li class="address-book__item">
								<div class="address-book__address">
									@if (address.IsDefault)
									{
										<span class="address-book__badge ucp-bg-color">@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.Default)</span>
									}
									<div>@address.AddressLine1</div>
									@if (!string.IsNullOrWhiteSpace(address.AddressLine2))
									{
										<div>@address.AddressLine2</div>
									}
									<div>@address.ZipCode @address.City</div>
									<div>@(string.Join(", ", new[] { entry.RegionName, entry.CountryName }.Where(x => !string.IsNullOrWhiteSpace(x))))</div>
								</div>
								<div class="address-book__actions">
									<a href="@($"{myAccountUrl}?editAddress={address.Id}#address-form")" class="button button--secondary button--small">
										@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.Edit)
									</a>
									@if (!address.IsDefault)
									{
										using (Html.BeginUmbracoForm("SetDefaultAddress", "UmbracoCommercePortalAccountSurface", FormMethod.Post, new { @class = "address-book__action" }))
										{
											<input type="hidden" name="addressId" value="@address.Id" />
											<button type="submit" class="button button--secondary button--small" name="address-book-action">
												@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.SetAsDefault)
											</button>
										}
									}
									@using (Html.BeginUmbracoForm("DeleteAddress", "UmbracoCommercePortalAccountSurface", FormMethod.Post, new { @class = "address-book__action", data_confirm = Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.ConfirmDeleteAddress) }))
									{
										<input type="hidden" name="addressId" value="@address.Id" />
										<button type="submit" class="button button--secondary button--small" name="address-book-action">
											@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.Delete)
										</button>
									}
								</div>
							</li>
						}
					</ul>
				}
			}
		</div>

		@if (Context.Request.HasFormContentType && Context.Request.Form.ContainsKey("address-book-action"))
		{
			<div class="auth__field">
				<div class="auth__error">
					@Html.ValidationSummary()
				</div>
			</div>
		}
	</div>

	<!-- Add / Edit Address -->
	@using (Html.BeginUmbracoForm("SaveAddress", "UmbracoCommercePortalAccountSurface", FormMethod.Post, new { @class = "form", id = "address-form" }))
	{
		<input type="hidden" asp-for="@addressModel.Id" />

		<div class="form__section">
			<h3 class="form__section-title">
				@Localize(isEditingAddress ? UmbracoCommercePortalConstants.Localization.AccountEntries.EditAddress : UmbracoCommercePortalConstants.Localization.AccountEntries.AddAddress)
			</h3>

			@if (!isEditingAddress)
			{
				<div class="form__row">
					<div class="form__field form__field--full">
						<label for="addressIsBilling" class="form__label">
							@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.AddressType)
						</label>
						<select id="addressIsBilling" name="addressModel.IsBilling" class="form__select">
							@if (string.Equals(selectedIsBilling, "false", StringComparison.OrdinalIgnoreCase))
							{
								<option value="true">@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.BillingAddress)</option>
								<option value="false" selected>@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.ShippingAddress)</option>
							}
							else
							{
								<option value="true" selected>@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.BillingAddress)</option>
								<option value="false">@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.ShippingAddress)</option>
							}
						</select>
					</div>
				</div>
			}

			<div class="form__row">
				<div class="form__field form__field--full">
					<label asp-for="@addressModel.AddressLine1" class="form__label">
						@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.StreetAddress)
					</label>
					<input type="text" asp-for="@addressModel.AddressLine1" class="form__input" />
				</div>
			</div>

			<div class="form__row">
				<div class="form__field form__field--full">
					<label asp-for="@addressModel.AddressLine2" class="form__label">
						@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.AddressLine2)
					</label>
					<input type="text" asp-for="@addressModel.AddressLine2" class="form__input" />
				</div>
			</div>

			<div class="form__row">
				<div class="form__field">
					<label asp-for="@addressModel.City" class="form__label">
						@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.City)
					</label>
					<input type="text" asp-for="@addressModel.City" class="form__input" />
				</div>
				<div class="form__field">
					<label asp-for="@addressModel.ZipCode" class="form__label">
						@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.ZipCode)
					</label>
					<input type="text" asp-for="@addressModel.ZipCode" class="form__input" />
				</div>
			</div>

			<div class="form__row">
				<div class="form__field">
					<label for="addressCountryId" class="form__label">
						@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.Country)
					</label>
					<select id="addressCountryId" name="addressModel.CountryId" class="form__select">
						<option value=""></option>
						@foreach (var country in countries)
						{
							if (country.Id.ToString() == selectedCountryId)
							{
								<option value="@country.Id" selected>@country.Name</option>
							}
							else
							{
								<option value="@country.Id">@country.Name</option>
							}
						}
					</select>
				</div>
				<div class="form__field" id="addressRegionField" hidden="@(!selectedCountryHasRegions)">
					<label for="addressRegionId" class="form__label">
						@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.State)
					</label>
					<select id="addressRegionId" name="addressModel.RegionId" class="form__select">
						<option value=""></option>
						@foreach (var region in regions)
						{
							if (region.Id.ToString() == selectedRegionId)
							{
								<option value="@region.Id" data-country="@region.CountryId" selected>@region.Name</option>
							}
							else
							{
								<option value="@region.Id" data-country="@region.CountryId">@region.Name</option>
							}
						}
					</select>
				</div>
			</div>

			@if (!(isEditingAddress && addressModel.IsDefault))
			{
				<div class="form__row">
					<label class="form__checkbox">
						<input type="checkbox" asp-for="@addressModel.IsDefault" />
						@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.UseAsDefault)
					</label>
				</div>
			}
		</div>

		@if (Context.Request.HasFormContentType && Context.Request.Form.ContainsKey("save-address-form"))
		{
			<div class="auth__field">
				<div class="auth__error">
					@Html.ValidationSummary()
				</div>
			</div>
		}

		<div class="form__actions">
			@if (isEditingAddress)
			{
				<a href="@($"{myAccountUrl}#address-book")" class="button button--secondary">
					@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.Cancel)
				</a>
			}
			<button type="submit" class="button button--primary ucp-bg-color" name="save-address-form">
				@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.Save)
			</button>
		</div>
	}


	<!-- Change Password -->
	@using (Html.BeginUmbracoForm("ChangePassword", "UmbracoCommercePortalAccountSurface", FormMethod.Post, new { @class = "form" }))
	{
		<div class="form__section">
			<h3 class="form__section-title">
				@Umbraco.GetDictionaryValueOrDefault(UmbracoCommercePortalConstants.Localization.AccountEntries.ChangePassword.Key, UmbracoCommercePortalConstants.Localization.AccountEntries.ChangePassword.DefaultValue)
			</h3>

			<div class="form__row">
				<div class="form__field">
					<label asp-for="@changePasswordModel.NewPassword" class="form__label">
						@Umbraco.GetDictionaryValueOrDefault(UmbracoCommercePortalConstants.Localization.AccountEntries.CurrentPassword.Key, UmbracoCommercePortalConstants.Localization.AccountEntries.CurrentPassword.DefaultValue)
					</label>
					<input type="text" asp-for="@changePasswordModel.CurrentPassword" class="form__input" />
				</div>
				<div class="form__field">
					<label asp-for="@changePasswordModel.NewPassword" class="form__label">
						@Umbraco.GetDictionaryValueOrDefault(UmbracoCommercePortalConstants.Localization.AccountEntries.NewPassword.Key, UmbracoCommercePortalConstants.Localization.AccountEntries.NewPassword.DefaultValue)
					</label>
					<input type="text" asp-for="@changePasswordModel.NewPassword" class="form__input" />
				</div>
			</div>
		</div>

		@if (Context.Request.HasFormContentType && Context.Request.Form.ContainsKey("change-password-form"))
		{
			<div class="auth__field">
				<div class="auth__error">
					@Html.ValidationSummary()
				</div>
			</div>
		}

		<div class="form__actions">
			<button type="submit" class="button button--primary ucp-bg-color" name="change-password-form">@Localize(UmbracoCommercePortalConstants.Localization.AccountEntries.Save)</button>
		</div>
	}
</div>

<script>
	(function () {
		// Show the state / province select only for countries that have regions, listing just that country's regions
		var country = document.getElementById('addressCountryId');
		var region = document.getElementById('addressRegionId');
		var regionField = document.getElementById('addressRegionField');
		if (country && region && regionField) {
			var regionOptions = Array.prototype.slice.call(region.querySelectorAll('option[data-country]'));
			var syncRegions = function () {
				var selected = region.value;
				regionOptions.forEach(function (option) { option.remove(); });
				var matches = regionOptions.filter(function (option) { return option.getAttribute('data-country') === country.value; });
				matches.forEach(function (option) { region.appendChild(option); });
				region.value = matches.some(function (option) { return option.value === selected; }) ? selected : '';
				regionField.hidden = matches.length === 0;
			};
			country.addEventListener('change', syncRegions);
			syncRegions();
		}

		document.querySelectorAll('form[data-confirm]').forEach(function (form) {
			form.addEventListener('submit', function (e) {
				if (!window.confirm(form.getAttribute('data-confirm'))) {
					e.preventDefault();
				}
			});
		});
	})();
</script>

@if (TempData["Success"] != null)
{
	@await Html.PartialAsync($"{UmbracoCommercePortalConstants.UmbracoCommercePortalViewPath}/Partials/UmbracoCommercePortalToast.cshtml",
	new ToastModel("success", TempData["Success"].ToString()))
}
